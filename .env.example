# HackerOne Hacker API credentials (Settings -> API Token on hackerone.com)
HACKERONE_API_USERNAME=
HACKERONE_API_TOKEN=

# Bugcrowd Hacker Portal session cookie, copied from a logged-in browser
# (devtools -> Application -> Cookies -> bugcrowd.com). Expires periodically
# and must be refreshed manually. Leave empty to skip Bugcrowd scope fetch
# (listing data still works without it).
BUGCROWD_SESSION_COOKIE=

## MongoDB (shared infra-hub instance, see ../infra-hub)
MONGO_HOST=infra-mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
